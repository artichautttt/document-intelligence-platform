LOG_LEVEL=INFO
MAX_CHUNK_CHARS=1500
CHROMA_PERSIST_DIRECTORY=.chroma

# "chroma" (par defaut, embarque) ou "qdrant" (serveur dedie)
VECTOR_STORE_BACKEND=chroma
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# Fournisseur LLM actif : anthropic (defaut), openai ou mistral.
# La cle du fournisseur actif est requise pour activer /query (sinon 503).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Model tiering : modele par role (vide = ANTHROPIC_MODEL, reference du cout sans optimisation)
LLM_SYNTHESIS_MODEL=
LLM_JUDGE_MODEL=
LLM_VERIFIER_MODEL=
# Etapes simples (reformulation, classification, extraction de metadonnees)
LLM_LIGHT_MODEL=claude-haiku-4-5

# Cache exact-match des reponses LLM (prompt normalise + modele), TTL en secondes
# LLM_CACHE_PATH vide = memoire seule ; sinon fichier JSON local persistant
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=1024
LLM_CACHE_PATH=

# Si defini, /documents et /query exigent l'en-tete X-API-Key correspondant
API_KEY=

# Tarifs USD par million de tokens, pour estimer le cout dans GET /metrics
# (0 = cout non calcule ; a renseigner d apres la grille tarifaire en vigueur)
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# Recherche : "hybrid" (dense + BM25, par defaut) ou "dense"
RETRIEVAL_MODE=hybrid

# Persistance des metriques GET /metrics (fichier SQLite ; vide = memoire seule)
METRICS_DB_PATH=

# Export OpenTelemetry (ex. Langfuse : https://<hote>/api/public/otel), groupe `otel` requis
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Agent de verification des reponses : none (defaut) ou crewai (uv sync --group agents)
ANSWER_VERIFICATION=none
VERIFICATION_MAX_REGENERATIONS=1

# Mot de passe admin Grafana (docker compose)
GRAFANA_ADMIN_PASSWORD=admin

# Tracking MLflow de l evaluation (defaut : file:./mlruns)
MLFLOW_TRACKING_URI=
