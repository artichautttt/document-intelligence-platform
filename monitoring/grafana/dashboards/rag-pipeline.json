{
  "uid": "rag-pipeline",
  "title": "Pipeline RAG",
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requêtes RAG / s (par issue)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(rag_queries_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latence par requête (secondes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taux de refus (depuis le démarrage de l'API)",
      "description": "Part des requêtes abouties où le modèle déclare sufficient_context=false. Les erreurs sont exclues.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rag_queries_total{outcome=\"refused\"}) / sum(rag_queries_total{outcome=~\"answered|refused\"})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Coût LLM moyen par requête (USD, tarif du modèle appelé)",
      "description": "rag_query_cost_usd : somme des appels LLM d'une requête au tarif du modèle effectivement appelé (tiering compris, hit de cache = 0).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rag_query_cost_usd_sum) / sum(rag_query_cost_usd_count)"
        }
      ]
    }
  ]
}
